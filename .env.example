# NEXUS — configuração (copie para .env e preencha)
# NUNCA suba o .env real para o git (já está no .gitignore)

NEXUS_PORT=3777
NEXUS_TOKEN=troque-por-uma-chave-longa-e-aleatoria
NEXUS_UPLOAD_DIR=/home/seu-usuario/Compartilhado
NEXUS_DB=/home/seu-usuario/.opencode/nexus/nexus.db
LINUX_TAILSCALE_IP=IP_DO_SEU_LINUX
WINDOWS_TAILSCALE_IP=IP_DO_SEU_WINDOWS
ANDROID_TAILSCALE_IP=IP_DO_SEU_ANDROID
WINDOWS_SSH_USER=usuario_ssh_do_windows
WINDOWS_WORKDIR=C:\NexusWork
NEXUS_SESSION_TTL_DAYS=30